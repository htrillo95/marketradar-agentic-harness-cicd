{
  "mcpServers": {
    "storage": {
      "type": "stdio",
      "command": "python3",
      "args": ["mcp-servers/storage/server.py"],
      "env": {
        "AGENT_ROLE": "${AGENT_ROLE:-}"
      }
    },
    "retrieval": {
      "type": "stdio",
      "command": "python3",
      "args": ["mcp-servers/retrieval/server.py"],
      "env": {
        "AGENT_ROLE": "${AGENT_ROLE:-}"
      }
    }
  }
}
